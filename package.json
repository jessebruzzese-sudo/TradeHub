{
  "name": "nextjs",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "generate:og-image": "node scripts/generate-og-image.mjs",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "selfcheck": "node scripts/selfcheck.mjs",
    "clean": "rimraf .next",
    "check:mvp": "npm run lint && npm run build && npm run selfcheck",
    "pw": "playwright test",
    "password": "node scripts/generate-password.mjs",
    "jwt": "node scripts/generate-jwt.mjs",
    "pw:ui": "playwright test --ui",
    "pw:report": "playwright show-report",
    "pw:seed": "node scripts/pw-seed-user.mjs",
    "pw:seed:qa": "node scripts/pw-seed-qa.mjs",
    "qa:seed": "node scripts/pw-seed-qa.mjs",
    "qa:e2e": "playwright test",
    "qa:gate": "node scripts/pw-seed-qa.mjs && playwright test",
    "qa:report": "playwright show-report",
    "test:availability-limits": "node scripts/test-availability-limits.mjs && vitest run src/lib/plan-limits",
    "test": "vitest run",
    "test:plan-limits": "vitest run src/lib/plan-limits",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:tradehub": "playwright test playwright/tradehub.spec.ts",
    "test:api:major": "playwright test playwright/api-major-endpoints.spec.ts --project=chromium",
    "test:platform:full": "playwright test playwright/platform-full-regression.spec.ts --project=chromium",
    "test:lib:enforcement": "vitest run src/lib/enforcement-sweep.test.ts src/lib/plan-limits.test.ts src/lib/trade-lock.test.ts src/lib/trade-validation.test.ts",
    "test:ci:full": "npm run lint && npm run typecheck && npm run test:lib:enforcement && npm run test:api:major && npm run test:platform:full && playwright test playwright/supabase-guardrails.spec.ts --project=chromium",
    "db:gen-types": "supabase gen types typescript --project-id jkcaukvywhmlnqfeovuv > src/lib/database.types.ts",
    "trade:audit": "tsx scripts/audit-trades.ts",
    "trade:audit:fix": "tsx scripts/audit-trades.ts --fix"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@hookform/resolvers": "^5.2.2",
    "@mui/material": "^9.1.2",
    "@netlify/plugin-nextjs": "^5.15.11",
    "@next/swc-wasm-nodejs": "^16.2.6",
    "@react-email/render": "^2.0.8",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.5.0",
    "axios": "^1.16.1",
    "bcrypt": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cookies-next": "^6.1.1",
    "date-fns": "^4.2.1",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "embla-carousel-react": "^8.6.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.6",
    "framer-motion": "^12.39.0",
    "input-otp": "^1.4.2",
    "jose": "^6.2.3",
    "lucide-react": "^1.16.0",
    "next": "^16.2.6",
    "next-themes": "^0.4.6",
    "openai": "^6.38.0",
    "pg": "^8.21.0",
    "postcss": "8.4.30",
    "radix-ui": "^1.4.3",
    "react": "^19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.6",
    "react-easy-crop": "^5.5.7",
    "react-hook-form": "^7.76.0",
    "react-icons": "^5.6.0",
    "react-resizable-panels": "^4.11.1",
    "recharts": "^3.8.1",
    "resend": "^6.12.3",
    "sonner": "^2.0.7",
    "stripe": "^22.1.1",
    "styled-jsx": "^5.1.7",
    "tailwind-merge": "^2.5.2",
    "tailwindcss": "^3.3.3",
    "tailwindcss-animate": "^1.0.7",
    "tesseract.js": "^7.0.0",
    "typescript": "^6.0.3",
    "unpdf": "^1.6.2",
    "uuid": "^14.0.0",
    "vaul": "^1.1.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
