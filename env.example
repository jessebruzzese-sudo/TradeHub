# Copy to .env.local and fill in values. Do not commit real secrets.

POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_DATABASE=
POSTGRES_USERNAME=
POSTGRES_PASSWORD=
POSTGRES_USE_SSL=
POSTGRES_SSL_CERT=

JWT_SECRET=

GOOGLE_PLACES_API_KEY=

STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
IMAGE_FILE_STORE=
JOB_FILE_STORE=

OPENAI_API_KEY=

NEXT_PUBLIC_API_BASE_URL=
BILLING_ENABLED=true
NEXT_PUBLIC_BILLING_ENABLED=true

# --- Billing simulation (local only; false in production) ---
NEXT_PUBLIC_ENABLE_BILLING_SIMULATION=false

# ABN Lookup (ABR web-services GUID)
# https://abr.business.gov.au/Tools/WebServiceRegistration
ABR_GUID=

# Stripe price IDs
STRIPE_PREMIUM_PRICE_ID=
STRIPE_PRICE_PREMIUM=
STRIPE_PRICE_BUSINESS_PRO_20=
STRIPE_PRICE_SUBCONTRACTOR_PRO_10=
STRIPE_PRICE_ALL_ACCESS_PRO_26=

# Playwright E2E (optional)
PW_BASE_URL=
PW_EMAIL=
PW_PASSWORD=
PW_PREMIUM_EMAIL=
PW_PREMIUM_PASSWORD=
PW_NO_ABN_EMAIL=
PW_NO_ABN_PASSWORD=
PW_PLASTERING_EMAIL=
PW_PLASTERING_PASSWORD=

# Emails
SENDGRID_KEY=
WELCOME_TEMPLATE_ID=
USER_CREATED_TEMPLATE_ID=
FORGOT_PASSWORD_TEMPLATE_ID=
PASSWORD_CHANGED_TEMPLATE_ID=
MESSAGE_SENT_TEMPLATE_ID=
EARLY_USER_TEMPLATE_ID=
SENDGRID_ADMIN_EMAILS=
SENDGRID_FROM_EMAIL=
SENDGRID_APP_BASE_URL=
SEND_USER_CREATED=false
SEND_MESSAGE_SENT=false
SEND_EARLY_USER=true

# Other settings
AVATAR_DEFAULT_IMAGE=default-avatar.png

# Discovery / search (recommended defaults for production)
DISCOVERY_EXCLUDE_TEST_ACCOUNTS=true
DISCOVERY_STRICT_RADIUS=true
DISCOVERY_DEBUG=0
